{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "视听质量检测工作站",
  "identifier": "com.vqa.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "视听质量检测工作站",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQ0E1Rjg0NjQ2MjQwMTQKUldRVVFHSmtoRi9LZWl4RjhlSjZ5SUZaSGFuc2kvd3puQzVFZmIzeHAyaUE1ejJ0dVdHTVVOekkK",
      "endpoints": [
        "https://raw.githubusercontent.com/meng587/vqa-rs/master/crates/vqa-tauri/update/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
