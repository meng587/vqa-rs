{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "视听质量检测工作站",
  "identifier": "com.vqa.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "视听质量检测工作站",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQ0E1Rjg0NjQ2MjQwMTQKUldRVVFHSmtoRi9LZWl4RjhlSjZ5SUZaSGFuc2kvd3puQzVFZmIzeHAyaUE1ejJ0dVdHTVVOekkK",
      "endpoints": [
        "https://raw.githubusercontent.com/meng587/vqa-rs/master/crates/vqa-tauri/update/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../../bin/mpv/mpv.exe": "bin/mpv.exe",
      "../../bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../../bin/ffprobe.exe": "bin/ffprobe.exe",
      "../../bin/avcodec-62.dll": "bin/avcodec-62.dll",
      "../../bin/avdevice-62.dll": "bin/avdevice-62.dll",
      "../../bin/avfilter-11.dll": "bin/avfilter-11.dll",
      "../../bin/avformat-62.dll": "bin/avformat-62.dll",
      "../../bin/avutil-60.dll": "bin/avutil-60.dll",
      "../../bin/swresample-6.dll": "bin/swresample-6.dll",
      "../../bin/swscale-9.dll": "bin/swscale-9.dll",
      "../../bin/vkit_davs2.exe": "bin/vkit_davs2.exe",
      "../../bin/diag_secret.json": "bin/diag_secret.json"
    }
  }
}
